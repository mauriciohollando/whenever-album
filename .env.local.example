# Copy to .env.local — never commit secrets.

# Stripe (same account as RFPCheck / other live products)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ALBUM=
STRIPE_PRICE_EXTRA_ALBUM=
STRIPE_PRICE_HARDCOVER=
STRIPE_PRICE_HARDCOVER_CART=
STRIPE_PRICE_SOFTCOVER=
STRIPE_PRICE_TEE=
STRIPE_PRICE_HOODIE=
STRIPE_PRICE_MUG=
STRIPE_PRICE_POSTER=

# Prodigi — printed albums (optional until you have an account)
PRODIGI_API_KEY=
# PRODIGI_SANDBOX=1
# PRODIGI_HARDCOVER_SKU=BOOK-FE-SQ
# PRODIGI_SOFTCOVER_SKU=BOOK-SOFT-SQ

# Printful — merch (optional until you have an account)
PRINTFUL_TOKEN=

# OpenAI — album plan (JSON pages). Optional photo fallback.
OPENAI_API_KEY=

# Nano Banana (Gemini 2.5 Flash Image) — photographs + likeness from uploads
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default is Nano Banana. For Nano Banana Pro: gemini-3-pro-image-preview
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Vercel Blob — uploads + generated photographs
BLOB_READ_WRITE_TOKEN=

# Public site URL (checkout redirects). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs album access tokens (any long random string)
ALBUM_TOKEN_SECRET=
