# Copy to .env.local — never commit secrets.

# Stripe (same account as RFPCheck / other live products)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ALBUM=

# OpenAI — album plan (JSON pages). Optional photo fallback.
OPENAI_API_KEY=

# Nano Banana (Gemini 2.5 Flash Image) — photographs + likeness from uploads
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default is Nano Banana. For Nano Banana Pro: gemini-3-pro-image-preview
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Vercel Blob — uploads + generated photographs
BLOB_READ_WRITE_TOKEN=

# Public site URL (checkout redirects). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs album access tokens (any long random string)
ALBUM_TOKEN_SECRET=
